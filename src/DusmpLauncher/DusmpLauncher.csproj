<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DusmpLauncher</AssemblyName>
    <RootNamespace>DusmpLauncher</RootNamespace>
    <Version>1.3.1</Version>
    <ApplicationIcon>UI/assets/app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Windows app uses the GUI subsystem; Linux keeps its console entry point. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
  </ItemGroup>

  <!-- UI, translations and dev fixtures ship as embedded resources so the
       single binary serves them over the app:// scheme with no loose files. -->
  <ItemGroup>
    <!-- The checks exercise pure helpers that are not part of the app's surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DownloadIntegrity</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JavaProvisioning</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LauncherUpdates</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../packaging/release/release-public-key.pem" LogicalName="DusmpLauncher.release-public-key.pem" />
    <EmbeddedResource Include="UI/**/*" WithCulture="false" />
    <EmbeddedResource Include="Localization/Languages/*.json" WithCulture="false" />
    <EmbeddedResource Include="Network/Fixtures/*.json" />
    <EmbeddedResource Include="Resources/UpdateNotifier/*.jar" />
  </ItemGroup>

</Project>
